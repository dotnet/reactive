<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>Microsoft.Reactive.Testing.Async - Testing Helper Library for AsyncRx.NET</AssemblyTitle>
    <Description>Reactive Extensions (AsyncRx) for .NET - Testing Library</Description>
    <PackageTags>Rx;Reactive;Extensions;Observable;LINQ;Events;Async</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuses the sync testing vocabulary (Recorded, Notification, Subscription, ReactiveTest)
         so scenarios stay portable between the sync and async platforms. Version matches the
         System.Reactive package that System.Reactive.Async references. -->
    <PackageReference Include="Microsoft.Reactive.Testing" Version="6.0.0" />
    <ProjectReference Include="..\System.Reactive.Async\System.Reactive.Async.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\NuGet.Readme.md" Pack="true" PackagePath="\readme.md" />
  </ItemGroup>

</Project>
