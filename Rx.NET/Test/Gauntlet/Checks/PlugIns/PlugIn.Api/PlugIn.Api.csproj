<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard1.1</TargetFramework>
    <LangVersion>13.0</LangVersion>

    <!--
    NETSDK1215: .NET Standard prior to 2.0 not recommended.
    Unfortunately, the test suite needs to cover .NET 4.5, which doesn't support .NET Standard 2.0.
    -->
    <NoWarn>$(NoWarn);NETSDK1215</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
    The netstandard1.1 TFM seems to bring in references to these packages whether you
    use them or not. They are old references that produce vulnerability warnings. We
    reference these more recent versions purely to avoid those errors - we're not actually
    using these.
    -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

</Project>
